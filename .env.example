RETAILOPS_APP_NAME=RetailOps AI
RETAILOPS_ENVIRONMENT=development
RETAILOPS_DATABASE_URL=sqlite+pysqlite:///./retailops.db
RETAILOPS_LOG_LEVEL=INFO
RETAILOPS_ROUTING_CONFIDENCE_THRESHOLD=0.65
RETAILOPS_MAX_RAG_ITERATIONS=3
RETAILOPS_LLM_PROVIDER=ollama
# Ollama is optional for drafting; factual domain results do not require an LLM.

# Integration settings. Run python -m app.integration.cli init to provision local credentials.
RETAILOPS_STATE_DIR=.retailops
RETAILOPS_GRANTS_FILE=secrets/grants.json
RETAILOPS_INTEGRITY_KEY=
RETAILOPS_EMBEDDING_MODEL_PATH=
RETAILOPS_EMBEDDING_IDENTITY=
RETAILOPS_OLLAMA_URL=http://localhost:11434
RETAILOPS_OLLAMA_MODEL=
# Do not run multiple workers with the local JSONL audit writer.

# Isolated M16 candidate only: python -m app.realtime.launch
RETAILOPS_STREAM_MODE=off
RETAILOPS_STREAM_SPEED=1
RETAILOPS_STREAM_SEED=42
# Set a private random value of >=32 characters before webhook mode.
RETAILOPS_STREAM_HMAC_KEY=
RETAILOPS_WEATHER_ENABLED=false
RETAILOPS_WEATHER_URL=https://api.open-meteo.com/v1/forecast
RETAILOPS_WEATHER_LAT=19.03
RETAILOPS_WEATHER_LON=73.03
RETAILOPS_WEATHER_ALLOWED_HOSTS=["api.open-meteo.com","archive-api.open-meteo.com"]
