# Optional local web settings; no credentials are included.
RETAILOPS_APP_NAME=RetailOps seasonal demo
RETAILOPS_ENVIRONMENT=development
RETAILOPS_LOG_LEVEL=INFO
# Demo database, port, role and worker interval are explicit CLI arguments.
# The demo launcher overrides database_url/state_dir/email_login and prints a temporary token.
# Keep worker opt-in; ordinary web startup does not start a generator.
# Configure seasonal assumptions using --config and the supplied seasonal.json.
